{
  "name": "@onedesk/cli",
  "version": "0.10.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "onedesk: the OneDesk command line (create, convert, read, edit and render documents) built on the same engines as the app; runs headless on the app's bundled Node runtime",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./args": "./src/args.ts",
    "./agent-skills": "./src/agent-skills.ts",
    "./mcp-launch": "./src/mcp-launch.ts",
    "./control-protocol": "./src/control-protocol.ts"
  },
  "bin": {
    "onedesk": "./bin/onedesk"
  },
  "scripts": {
    "build": "node build.mjs && node collect-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onedesk/ai-provider": "*",
    "@onedesk/ai-search": "*",
    "@onedesk/doc2docx": "*",
    "@onedesk/docx-engine": "*",
    "@onedesk/hwp2docx": "*",
    "@onedesk/odf2ooxml": "*",
    "@onedesk/pdf2docx": "*",
    "@onedesk/pipelines": "*",
    "@onedesk/ppt2pptx": "*",
    "@onedesk/pptx-engine": "*",
    "@onedesk/pptx-ops": "*",
    "@onedesk/pptx-render": "*",
    "@onedesk/xlsx-gateway": "*",
    "@onedesk/zip-gate": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@rhwp/core": "0.8.7",
    "@tiptap/core": "3.31.0",
    "jsdom": "^28.0.0",
    "jszip": "^3.10.1",
    "numfmt": "^3.2.6",
    "pngjs": "^7.0.0",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
