{
  "name": "@onedesk/shell",
  "productName": "OneDesk",
  "version": "0.13.0",
  "license": "Apache-2.0",
  "homepage": "https://onedesk.jiulu.ltd",
  "private": true,
  "description": "Unified OneDesk shell: one app hosting the docs and sheets modules behind a home/launcher window",
  "main": "out/main/index.js",
  "desktopName": "onedesk.desktop",
  "scripts": {
    "predev": "node ../../tools/fix-electron-dev-name.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win",
    "dist:linux": "npm run notices && electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@onedesk/agent-core": "*",
    "@onedesk/ai-provider": "*",
    "@onedesk/ai-search": "*",
    "@onedesk/docs": "*",
    "@onedesk/docx-engine": "*",
    "@onedesk/electron-utils": "*",
    "@onedesk/cli": "*",
    "@onedesk/i18n": "*",
    "@onedesk/pipelines": "*",
    "@onedesk/pptx-engine": "*",
    "@onedesk/pptx-render": "*",
    "@onedesk/sheets": "*",
    "@onedesk/slides": "*",
    "@onedesk/project-store": "*",
    "@onedesk/ui": "*",
    "@onedesk/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.8.8",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "jszip": "^3.10.1",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "author": "OneDesk"
}
